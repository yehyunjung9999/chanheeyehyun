# 이 파일을 복사해서 .env.local 을 만들고 값을 채워요. .env.local 은 GitHub에 올리지 않아요.

# Supabase → Project Settings → API (두 선생님 모두 필요, 공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → 위쪽 Connect → "Session pooler" 주소(비밀번호 칸을 실제 DB 비밀번호로 바꿔서). DB 만들기·가짜 데이터 넣기에만 써요(A 선생님만)
DATABASE_URL=

# Claude API 키(A 선생님만, AI 보충 활동지에만 씀). 비워 두면 활동지 생성 버튼이 안내만 보여요
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
