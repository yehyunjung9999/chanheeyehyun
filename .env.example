# 이 파일을 복사해서 .env.local 을 만들고 값을 채워요. .env.local 은 GitHub에 올리지 않아요.

# Supabase → Project Settings → API (두 선생님 모두 필요, 공개돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Authentication → Sign In / Providers 에서 Google을 켠 뒤에만 on 으로 바꿔요. 비워 두면 구글 버튼이 숨어요
NEXT_PUBLIC_GOOGLE_LOGIN=

# Supabase → 위쪽 Connect → "Session pooler" 주소를 복사한 그대로 붙여요. DB 만들기·가짜 데이터 넣기에만 써요(A 선생님만)
DATABASE_URL=
# 프로젝트 만들 때 정한 DB 비밀번호. 주소 속 [YOUR-PASSWORD] 자리에 자동으로 들어가요(A 선생님만)
DB_PASSWORD=

# Claude API 키(A 선생님만, AI 보충 활동지에만 씀). 비워 두면 활동지 생성 버튼이 안내만 보여요
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
